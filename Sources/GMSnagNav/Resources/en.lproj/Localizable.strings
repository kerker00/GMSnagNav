/* The VoiceOver action that collapses a row. */
"Collapse" = "Collapse";

/* The VoiceOver value of a collapsed row. */
"Collapsed" = "Collapsed";

/* The VoiceOver action that expands a row. */
"Expand" = "Expand";

/* The VoiceOver value of an expanded row. */
"Expanded" = "Expanded";

/* The accessibility label of the text field for renaming a row. */
"Name" = "Name";

/* Moves an outline item one position earlier among its siblings. */
"Move Up" = "Move Up";

/* Moves an outline item one position later among its siblings. */
"Move Down" = "Move Down";

/* The accessibility label of an outline in sidebar style on macOS. */
"Sidebar" = "Sidebar";
